		summarizeBy: none
		sourceColumn: roc_auc

		annotation SummarizationSetBy = Automatic

	partition ModelComparison = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(RepoRootPath & "\data\processed\model_comparison.csv"), [Delimiter=",", Encoding=1252, QuoteStyle=QuoteStyle.Csv]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					SelectedColumns = Table.SelectColumns(PromotedHeaders, {"model", "accuracy", "precision", "recall", "f1_score", "roc_auc"}),
					ChangedType = Table.TransformColumnTypes(SelectedColumns, {{"model", type text}, {"accuracy", type number}, {"precision", type number}, {"recall", type number}, {"f1_score", type number}, {"roc_auc", type number}})
				in
					ChangedType

	annotation PBI_ResultType = Table
